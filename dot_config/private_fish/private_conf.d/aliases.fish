alias l 'eza --icons -l -a --header --sort=name -t modified --time-style="+%Y/%m/%d %H:%M"'
alias lm 'eza --icons -l -a --header --sort=modified -t modified --time-style="+%Y/%m/%d %H:%M"'
alias lc 'eza --icons -l -a --header --sort=created -t created --time-style="+%Y/%m/%d %H:%M"'
alias lC 'eza --icons -l -a --header --sort=changed -t changed --time-style="+%Y/%m/%d %H:%M"'
alias la 'eza --icons -l -a --header --sort=accessed -t accessed --time-style="+%Y/%m/%d %H:%M"'
alias lw 'eza --icons -l -a --header --sort=size -t modified --time-style="+%Y/%m/%d %H:%M" --total-size'

